# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real keys.

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Stripe (Singapore account — Developers → API keys)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Google Sign-In (Google Cloud Console → APIs & Services → Credentials)
# Create OAuth clients: Web application + iOS (bundle ID com.marugen.marugenApp)
# In Supabase: Authentication → Providers → Google → enable, paste Web client ID + secret
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Also copy ios/Flutter/Secrets.xcconfig.example → Secrets.xcconfig and set:
#   GOOGLE_IOS_CLIENT_ID=same as above
#   GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.PREFIX-FROM-IOS-CLIENT-ID

# Server-side only (used in Supabase Edge Functions, NOT in the app):
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# QXPRESS_API_KEY=xxx
# QXPRESS_API_BASE_URL=https://api.qxpress.net
