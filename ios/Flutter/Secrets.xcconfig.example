// Copy to Secrets.xcconfig and fill in values from Google Cloud Console.
// Never commit Secrets.xcconfig (it is gitignored).
//
// GOOGLE_IOS_CLIENT_ID looks like: 123456789-abcdef.apps.googleusercontent.com
// GOOGLE_REVERSED_CLIENT_ID is that ID reversed:
//   com.googleusercontent.apps.123456789-abcdef

GOOGLE_IOS_CLIENT_ID=
GOOGLE_REVERSED_CLIENT_ID=

// Apple Pay merchant ID (Apple Developer → Identifiers → Merchant IDs),
// looks like: merchant.com.marugen.marugenApp
// Also set the same value as APPLE_MERCHANT_ID in the app's .env so
// Stripe.merchantIdentifier matches this entitlement.
APPLE_MERCHANT_ID=
